# EditorConfig: https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# gofmt decides the layout of Go files.
[{*.go,go.mod}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Golden vectors are tab-separated and copied byte for byte from hh-cpp.
[testdata/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
